<%# app/views/analyses/_result_feature_importance.html.erb %>
<% result = analysis.result %>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-value"><%= result["n_cases"] %></div>
      <div class="stat-label"><%= t("analyses.show.n_cases") %></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-value"><%= result["n_genes_total"] %></div>
      <div class="stat-label"><%= t("analyses.show.n_genes_total") %></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-value"><%= result["top_genes"]&.length %></div>
      <div class="stat-label"><%= t("analyses.show.top_genes") %></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-value"><%= result["n_trees"] %></div>
      <div class="stat-label"><%= t("analyses.show.n_trees") %></div>
    </div>
  </div>
</div>

<div class="card chart-card mb-4">
  <div class="card-header"><%= t("analyses.show.top_genes_chart") %></div>
  <div class="card-body">
    <div id="fiChart" style="height: 500px;"></div>
  </div>
</div>

<script>
  (() => {
    const genes = <%= result["top_genes"].first(30).map { |g| g["gene"] }.to_json.html_safe %>;
    const importances = <%= result["top_genes"].first(30).map { |g| g["importance"] }.to_json.html_safe %>;
    const I18N = {
      title:      "<%= t('analyses.show.top_genes_chart') %>",
      importance: "<%= t('analyses.show.importance') %>",
      gene:       "<%= t('analyses.show.gene') %>"
    };

    Plotly.newPlot("fiChart", [{
      type: "bar",
      orientation: "h",
      x: importances.slice().reverse(),
      y: genes.slice().reverse(),
      marker: { color: "#6366f1" },
      hovertemplate: `<b>%{y}</b><br>${I18N.importance}: %{x:.4f}<extra></extra>`
    }], {
      title: I18N.title,
      xaxis: { title: I18N.importance },
      yaxis: { title: I18N.gene, automargin: true },
      margin: { l: 120, r: 40, t: 60, b: 60 }
    }, { responsive: true });
  })();
</script>
