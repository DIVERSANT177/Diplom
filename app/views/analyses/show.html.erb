<%# app/views/analyses/show.html.erb %>
<% content_for :head do %>
  <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<% end %>

<div class="container py-4">

  <%# Page header %>
  <div class="page-header d-flex align-items-center justify-content-between">
    <div>
      <h1><%= t("analyses.algorithms.#{@analysis.algorithm}") %></h1>
      <p class="text-muted mb-0"><%= @dashboard.title %> &mdash; <%= @dashboard.projects&.join(", ") %></p>
    </div>
    <div class="d-flex gap-2">
      <% if @analysis.algorithm == "survival" && @analysis.ready? %>
        <%= link_to new_dashboard_prediction_path(@dashboard, analysis_id: @analysis.id), class: "btn btn-primary" do %>
          <%= t("predictions.open_predict") %>
        <% end %>
      <% end %>
      <%= link_to dashboard_analyses_path(@dashboard), class: "btn btn-outline-secondary" do %>
        <%= t("pipeline.back_to_analyses") %>
      <% end %>
      <%= link_to @dashboard, class: "btn btn-outline-secondary" do %>
        <%= t("pipeline.back_to_dashboard") %>
      <% end %>
    </div>
  </div>

  <%# Pending / Error %>
  <% if @analysis.pending? || @analysis.running? %>
    <div class="alert alert-info d-flex align-items-center gap-3">
      <div class="spinner-border spinner-border-sm" role="status"></div>
      <span><%= t("analyses.show.running") %></span>
    </div>
    <meta http-equiv="refresh" content="5">

  <% elsif @analysis.error? %>
    <div class="alert alert-danger">
      <strong><%= t("analyses.show.error") %></strong>
      <%= @analysis.error_message %>
    </div>

  <% elsif @analysis.ready? %>
    <%= render "result_#{@analysis.algorithm}", analysis: @analysis %>
  <% end %>

</div>
