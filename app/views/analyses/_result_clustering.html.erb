<%# app/views/analyses/_result_clustering.html.erb %>
<% result = analysis.result %>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-4">
    <div class="stat-card">
      <div class="stat-value"><%= result["n_clusters"] %></div>
      <div class="stat-label"><%= t("analyses.show.n_clusters") %></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-4">
    <div class="stat-card">
      <div class="stat-value"><%= result["silhouette_score"] %></div>
      <div class="stat-label"><%= t("analyses.show.silhouette_score") %></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-4">
    <div class="stat-card">
      <div class="stat-value"><%= result["n_cases"] %></div>
      <div class="stat-label"><%= t("analyses.show.n_cases") %></div>
    </div>
  </div>
</div>

<%# Cluster stats table %>
<div class="card mb-4">
  <div class="card-header"><%= t("analyses.show.cluster_stats") %></div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th><%= t("analyses.show.cluster") %></th>
          <th><%= t("analyses.show.n_patients") %></th>
          <th><%= t("analyses.show.n_dead") %></th>
          <th><%= t("analyses.show.mortality_rate") %></th>
          <th><%= t("analyses.show.median_age") %></th>
          <th><%= t("analyses.show.median_survival") %></th>
        </tr>
      </thead>
      <tbody>
        <% result["cluster_stats"].each do |stat| %>
          <tr>
            <td><span class="badge bg-primary"><%= t("analyses.show.cluster") %> <%= stat["cluster"] %></span></td>
            <td><%= stat["n_patients"] %></td>
            <td><%= stat["n_dead"] %></td>
            <td><%= "#{(stat["mortality_rate"] * 100).round(1)}%" %></td>
            <td><%= stat["median_age"] || t("common.no_data") %></td>
            <td><%= stat["median_survival"] ? "#{stat["median_survival"].to_i} #{t('common.days_short')}" : t("common.no_data") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# Cluster distribution chart %>
<div class="card chart-card mb-4">
  <div class="card-header"><%= t("analyses.show.cluster_distribution") %></div>
  <div class="card-body">
    <div id="clusterChart" style="height: 400px;"></div>
  </div>
</div>

<script>
  (() => {
    const stats = <%= result["cluster_stats"].to_json.html_safe %>;
    const colors = ["#6366f1", "#f472b6", "#22c55e", "#f59e0b", "#06b6d4"];
    const I18N = {
      cluster:   "<%= t('analyses.show.cluster') %>",
      patients:  "<%= t('analyses.show.n_patients') %>",
      mortality: "<%= t('analyses.show.mortality_label') %>"
    };

    Plotly.newPlot("clusterChart", [{
      type: "bar",
      x: stats.map(s => `${I18N.cluster} ${s.cluster}`),
      y: stats.map(s => s.n_patients),
      marker: { color: stats.map((_, i) => colors[i % colors.length]) },
      text: stats.map(s => `${(s.mortality_rate * 100).toFixed(1)}% ${I18N.mortality}`),
      textposition: "outside",
      hovertemplate: `<b>%{x}</b><br>${I18N.patients}: %{y}<br>%{text}<extra></extra>`
    }], {
      xaxis: { title: I18N.cluster },
      yaxis: { title: I18N.patients },
      margin: { t: 40 }
    }, { responsive: true });
  })();
</script>
