<div class="container py-4">
  <div class="page-header d-flex align-items-center justify-content-between">
    <h1><%= t('dashboards.index.title') %></h1>
    <%= link_to t('dashboards.index.new_button'), new_dashboard_path, class: "btn btn-primary" %>
  </div>

  <% if @dashboards.any? %>
    <div class="row g-4">
      <% @dashboards.each do |dashboard| %>
        <div class="col-md-6 col-lg-4">
          <div class="card dashboard-card h-100">
            <div class="card-body">
              <h5 class="card-title fw-bold mb-3"><%= dashboard.title %></h5>

              <div class="d-flex flex-wrap gap-2 mb-3">
                <% status_class = case dashboard.status
                     when "ready" then "bg-success"
                     when "fetching" then "bg-warning text-dark"
                     when "error" then "bg-danger"
                     else "bg-secondary"
                   end %>
                <span class="badge <%= status_class %>"><%= t("dashboards.status.#{dashboard.status}") %></span>
                <span class="badge bg-light text-dark"><%= dashboard.projects.join(", ") %></span>
              </div>

              <div class="small text-muted mb-2">
                <strong><%= t('dashboards.fields.total_cases') %>:</strong>
                <%= dashboard.total_cases.presence || t('common.not_loaded') %>
              </div>
              <div class="small text-muted mb-2">
                <strong><%= t('dashboards.fields.top_genes_count') %>:</strong>
                <%= dashboard.top_genes_count %>
              </div>
              <div class="small text-muted">
                <strong><%= t('dashboards.fields.created_at') %>:</strong>
                <%= l(dashboard.created_at, format: :short) %>
              </div>
            </div>
            <div class="card-footer bg-white border-top-0 d-flex gap-2">
              <%= link_to t('dashboards.index.open'), dashboard, class: "btn btn-sm btn-primary flex-fill" %>
              <%= button_to t('dashboards.index.delete'), dashboard, method: :delete,
                  data: { confirm: t('common.confirm_delete') },
                  class: "btn btn-sm btn-outline-danger" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <p class="text-muted fs-5"><%= t('dashboards.index.empty') %></p>
      <%= link_to t('dashboards.index.new_button'), new_dashboard_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>
