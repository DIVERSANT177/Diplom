<%= form_with(model: dashboard, class: "needs-validation") do |form| %>
  <% if dashboard.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading fw-bold"><%= t('common.errors', count: dashboard.errors.count) %></h6>
      <ul class="mb-0">
        <% dashboard.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label fw-bold" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <label class="form-label fw-bold"><%= t('dashboards.form.tcga_projects') %></label>
    <div class="row g-2">
      <% @projects.each do |project| %>
        <div class="col-md-6 col-lg-4">
          <div class="form-check">
            <%= check_box_tag "dashboard[projects][]",
                project["project_id"],
                dashboard.projects.include?(project["project_id"]),
                id: "dashboard_projects_#{project["project_id"]}",
                class: "form-check-input" %>
            <%= label_tag "dashboard_projects_#{project["project_id"]}",
                "#{project["project_id"]} — #{Array(project["primary_site"]).first}",
                class: "form-check-label" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-bold"><%= t('dashboards.form.visualizations') %></label>
    <% Dashboard::VISUALIZATIONS.each do |viz| %>
      <div class="form-check">
        <%= check_box_tag "dashboard[visualizations][]",
            viz,
            dashboard.visualizations.include?(viz),
            id: "dashboard_visualizations_#{viz}",
            class: "form-check-input" %>
        <%= label_tag "dashboard_visualizations_#{viz}",
            Dashboard.visualization_label(viz),
            class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <div class="mb-3" id="stratify_by_field" style="display: none;">
    <%= form.label :stratify_by, t('dashboards.form.stratify_by'), class: "form-label fw-bold" %>
    <%= form.select :stratify_by,
        [
          [t('dashboards.form.stratify_options.gender'), "gender"],
          [t('dashboards.form.stratify_options.tumor_stage'), "tumor_stage"],
          [t('dashboards.form.stratify_options.project_id'), "project_id"]
        ],
        { include_blank: t('common.not_selected') },
        { class: "form-select" } %>
  </div>

  <div class="mb-4">
    <%= form.label :top_genes_count, class: "form-label fw-bold" %>
    <%= form.number_field :top_genes_count, min: 10, max: 200, class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t('cancel'), dashboards_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<script>
  function toggleStratify() {
    const field = document.getElementById('stratify_by_field');
    if (!field) return;

    const kmChecked = document.querySelector('input[value="kaplan_meier"]')?.checked;
    field.style.display = kmChecked ? 'block' : 'none';
  }

  document.addEventListener('DOMContentLoaded', toggleStratify);

  document.querySelectorAll('input[name="dashboard[visualizations][]"]')
          .forEach(cb => cb.addEventListener('change', toggleStratify));
</script>
